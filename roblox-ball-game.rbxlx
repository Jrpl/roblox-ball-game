			<Properties>
				<ProtectedString name="Source"><![CDATA[print("Hello test, from server!")
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{364FD99A-9DE4-4516-B228-63E9CB30288F}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Server</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">3d77307d4b3df9f50ae0bd4500002002</UniqueId>
			</Properties>
			<Item class="Script" referent="RBXA6E6802C0F5045C2B62A6F74019400FE">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.BallConfig)
local PhysProperties = PhysicalProperties.new(Config.Density, Config.Friction, Config.Elasticity, 1, 1)
local spawn = workspace.Start.Spawn
local balls = {}

Players.PlayerAdded:Connect(function(player)
    print("Player joined: " .. player.Name)
    local ball = Instance.new("Part")
    ball.Name = "PlayerBall"
    ball.Anchored = false
    ball.Shape = Enum.PartType.Ball
    ball.Color = Color3.new(0.031373, 0.54902, 0.752941)
    ball.Size = Vector3.one * Config.BallDiameter
    ball.CustomPhysicalProperties = PhysProperties
    ball.CFrame = spawn.WorldCFrame + Vector3.yAxis * (Config.BallDiameter / 2)
    ball:SetAttribute("UserId", player.UserId)
    ball.Parent = workspace
    ball:SetNetworkOwner(player)
    balls[player.UserId] = ball
end)

Players.PlayerRemoving:Connect(function(player)
    print("Player left: " .. player.Name)
    local ball = balls[player.UserId]
    if ball then
        ball:Destroy()
        balls[player.UserId] = nil
    end
end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
